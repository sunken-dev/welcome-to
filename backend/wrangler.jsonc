{
  "name": "exchange-welcome-to",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "exchange.welcome-to.sunken.dev",
      "custom_domain": true
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
