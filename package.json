{
  "name": "welcome-to-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test harness for the Welcome To sheet and the exchange relay. Not part of either deployment.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:frontend:gui": "vitest run --project frontend tests/frontend/gui",
    "test:frontend:game-logic": "vitest run --project frontend tests/frontend/game-logic",
    "test:frontend:multiplayer": "vitest run --project frontend tests/frontend/multiplayer",
    "test:backend": "vitest run --project backend",
    "test:backend:game-logic": "vitest run --project backend tests/backend/game-logic",
    "test:backend:health": "vitest run --project backend tests/backend/health",
    "test:backend:storage": "vitest run --project backend tests/backend/storage"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
